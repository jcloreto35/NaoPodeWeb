{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null && (!data.exists() || data.child('status').val() === 'waiting' || data.child('players').child(auth.uid).exists())",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['hostUid', 'status', 'config', 'players'])",
        "status": {
          ".write": "auth != null && auth.uid === root.child('rooms').child($roomCode).child('hostUid').val()",
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing')"
        },
        "hostUid": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "config": {
          ".write": "auth != null && auth.uid === root.child('rooms').child($roomCode).child('hostUid').val()",
          ".validate": "newData.hasChildren(['teams', 'selectedTime'])"
        },
        "game": {
          ".write": "auth != null && auth.uid === root.child('rooms').child($roomCode).child('hostUid').val()",
          ".validate": "!newData.exists() || newData.hasChildren(['phase', 'teams', 'selectedTime', 'currentTeam', 'cardIndex', 'usedCardIndexes'])"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomCode).child('status').val() === 'waiting' && newData.exists()",
            ".validate": "!newData.exists() || newData.hasChild('name')",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
